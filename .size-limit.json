[
  {
    "name": "All JS chunks (gzip total)",
    "path": ".next/static/chunks/**/*.js",
    "limit": "440 kB",
    "gzip": true
  },
  {
    "name": "Framework chunk (React + Next.js runtime)",
    "path": ".next/static/chunks/framework-*.js",
    "limit": "48 kB",
    "gzip": true
  },
  {
    "name": "Route: /asset/[id] (gzip)",
    "path": ".next/static/chunks/app/asset/**/*.js",
    "limit": "60 kB",
    "gzip": true
  },
  {
    "name": "Route: /portfolio (gzip)",
    "path": ".next/static/chunks/app/portfolio/**/*.js",
    "limit": "60 kB",
    "gzip": true
  },
  {
    "name": "Route: /issuer (gzip)",
    "path": ".next/static/chunks/app/issuer/**/*.js",
    "limit": "60 kB",
    "gzip": true
  }
]