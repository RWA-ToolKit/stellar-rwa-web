{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "incremental": false
  },
  "include": ["server/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", ".next", "app", "components", "hooks", "lib"]
}
